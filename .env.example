# Copy to .env and fill in. The .env file is gitignored.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-4-6 (default, cheaper) or claude-opus-4-8 (max quality)
MODEL=claude-sonnet-4-6

# --- Gmail ---
# Gmail search query selecting the StepStone alert emails (sender confirmed from real
# captures; newer_than:7d keeps scans off old mail). Omit to use this same default.
GMAIL_QUERY=from:info@jobagent.stepstone.de newer_than:7d
GMAIL_CLIENT_SECRET=credentials/client_secret.json
GMAIL_TOKEN=credentials/token.json

# --- Notification ---
# Address the digest email is sent to (your own inbox).
NOTIFY_TO=ssipik@gmail.com

# --- Analysis / storage ---
# Only jobs scoring >= threshold are highlighted in the digest.
SCORE_THRESHOLD=60
DB_PATH=data/jobs.db
